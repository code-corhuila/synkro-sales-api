# Placeholder values only. Never commit real credentials or public/private key material.
HTTP_PORT=8080
# The runtime consumes MONGODB_URI; Compose maps the dedicated application input below.
# sales_app is authenticated in admin, with Sales-owned grants and bounded connections.
SALES_APP_MONGODB_URI=mongodb://sales_app:<URL_ENCODED_SALES_APP_PASSWORD>@synkro-mongo:27017/sales?replicaSet=rs0&authSource=admin&connectTimeoutMS=2000&serverSelectionTimeoutMS=5000&socketTimeoutMS=10000&retryWrites=false
MONGODB_TIMEOUT=5s
MONGODB_MAX_POOL_SIZE=10
# Compose selects only this read-only Auth PUBLIC key file; never mount its private key.
JWT_PUBLIC_KEY_PATH=/absolute/protected/auth-public.pem
# Outside Compose, the binary also supports exactly one inline JWT_PUBLIC_KEY
# or accessible JWT_PUBLIC_KEY_FILE. Do not configure both runtime sources.
