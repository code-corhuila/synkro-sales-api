# No real values belong in this file or in any committed .env file.
HTTP_PORT=8080
# Reserved for the future composition root; health does not connect to MongoDB.
# Substitute an URL-encoded SALES_APP_PASSWORD at runtime using secret storage.
# The sales_app user is bootstrapped in admin; migrations grant sales_writer@sales.
MONGODB_URI=mongodb://sales_app:<URL_ENCODED_SALES_APP_PASSWORD>@synkro-mongo:27017/sales?replicaSet=rs0&authSource=admin&serverSelectionTimeoutMS=5000&retryWrites=false
